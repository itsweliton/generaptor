{
  "name": "generaptor",
  "version": "0.2.0",
  "description": "Generate themeable React forms from a schema.",
  "type": "module",
  "main": "./dist/generaptor.cjs",
  "module": "./dist/generaptor.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/generaptor.js",
      "require": "./dist/generaptor.cjs"
    },
    "./style.css": "./dist/generaptor.css"
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welitonderesende/generaptor.git"
  },
  "keywords": [
    "react",
    "forms",
    "form-generator",
    "material-ui",
    "validation",
    "schema"
  ],
  "author": "Weliton de Resende <welitonderesende@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/welitonderesende/generaptor/issues"
  },
  "homepage": "https://github.com/welitonderesende/generaptor#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:site": "BUILD_TARGET=site vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^6.4.0 || ^7.0.0 || ^8.0.0 || ^9.0.0",
    "@mui/x-date-pickers": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "date-fns": "^3.2.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
